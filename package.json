{
  "name": "@browserops/monorepo",
  "version": "0.0.8",
  "private": true,
  "description": "MCP server that drives a live Chrome browser profile",
  "type": "module",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "setup": "pnpm install && pnpm build && node packages/cli/dist/index.js init",
    "start": "pnpm build && node packages/cli/dist/index.js start",
    "start:fast": "node packages/cli/dist/index.js start",
    "dev": "concurrently -n shared,bridge,ext,cli -c cyan,green,magenta,yellow \"pnpm -F @browserops/shared dev\" \"pnpm -F @browserops/bridge dev\" \"pnpm -F @browserops/extension dev\" \"pnpm -F browserops dev\"",
    "build": "pnpm -r --sequential build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @browserops/bridge test:integration",
    "test:smoke": "pnpm --filter @browserops/extension test:smoke",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "bump": "node scripts/bump-version.mjs",
    "release": "pnpm -r publish --access public --no-git-checks",
    "release:dry": "pnpm -r publish --access public --no-git-checks --dry-run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
