{
  "name": "@browserops/bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "browserops-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@browserops/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
