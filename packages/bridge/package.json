{
  "name": "@browserops/bridge",
  "version": "0.0.9",
  "type": "module",
  "description": "MCP stdio server + WebSocket primary for browserops — drives the browserops Chrome extension. Install `browserops` for the user-facing CLI.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "browser-automation",
    "chrome",
    "websocket",
    "claude-code",
    "browserops"
  ],
  "homepage": "https://github.com/quaylabshq/browserops#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quaylabshq/browserops.git",
    "directory": "packages/bridge"
  },
  "bugs": {
    "url": "https://github.com/quaylabshq/browserops/issues"
  },
  "license": "MIT",
  "author": "Saket Aryan",
  "bin": {
    "browserops-daemon": "./dist/daemon.js",
    "browserops-shim": "./dist/shim.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/assets/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "ws": "^8.18.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@browserops/shared": "workspace:*",
    "@types/node": "^22.19.20",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  }
}
